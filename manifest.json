{
  "schemaVersion": 1,
  "id": "pingscope.latency",
  "name": "PingScope",
  "version": "1.4.2",
  "author": "PingScope Project",
  "license": "MIT",
  "description": "Current ICMP latency for up to four websites, colored green, yellow, or red by response time.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "PingScope",
    "description": "Current latency for up to four sites, colored by response time.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sites": ["google.com", "github.com", "cloudflare.com", "reddit.com"],
      "focusedSite": 0,
      "closedRefreshSec": 1,
      "ipVersion": 4,
      "timeoutSec": 10,
      "running": true
    },
    "schema": [
      {
        "key": "sites",
        "type": "string",
        "label": "Sites",
        "description": "Up to four hostnames (comma or space separated in shell.json). Edited in shell.json; the widget has no panel.",
        "defaultValue": "google.com, github.com, cloudflare.com, reddit.com"
      },
      {
        "key": "focusedSite",
        "type": "integer",
        "label": "Focused site index",
        "min": 0,
        "max": 3,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "closedRefreshSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "ipVersion",
        "type": "integer",
        "label": "IP version",
        "min": 4,
        "max": 6,
        "step": 2,
        "defaultValue": 4
      },
      {
        "key": "timeoutSec",
        "type": "integer",
        "label": "Reply timeout (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 10,
        "description": "How long a probe waits before the site counts as down. A slower reply shows as its latency."
      },
      {
        "key": "running",
        "type": "boolean",
        "label": "Run probes",
        "defaultValue": true
      }
    ]
  }
}
