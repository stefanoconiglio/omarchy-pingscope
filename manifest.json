{
  "schemaVersion": 1,
  "id": "io.github.stefanoconiglio.pingscope",
  "name": "PingScope (pill)",
  "version": "1.4.2",
  "author": "PingScope Project; plain bar face by Stefano Coniglio",
  "license": "MIT",
  "description": "Fork of PingScope: the bar shows the latency in green, yellow or red on a dark pill outlined in the bar's text colour, readable on every theme; the panel is unchanged.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "PingScope (pill)",
    "description": "Latency to the focused site, coloured by response time, on a dark outlined pill.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sites": [
        "google.com"
      ],
      "focusedSite": 0,
      "closedRefreshSec": 1,
      "openRefreshSec": 1,
      "ipVersion": 4,
      "running": true
    },
    "schema": [
      {
        "key": "sites",
        "type": "string",
        "label": "Sites",
        "description": "Up to four hostnames (comma or space separated in shell.json). Normally edited from the widget's panel.",
        "defaultValue": "google.com"
      },
      {
        "key": "focusedSite",
        "type": "integer",
        "label": "Focused site index",
        "min": 0,
        "max": 3,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "closedRefreshSec",
        "type": "integer",
        "label": "Closed refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "openRefreshSec",
        "type": "integer",
        "label": "Open refresh interval (seconds)",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "ipVersion",
        "type": "integer",
        "label": "IP version",
        "min": 4,
        "max": 6,
        "step": 2,
        "defaultValue": 4
      },
      {
        "key": "running",
        "type": "boolean",
        "label": "Run probes",
        "defaultValue": true
      }
    ]
  }
}
